{
  "id": "save-latest-article-and-view-in-saved",
  "testPlanId": "60b604ea-a15b-49ce-b336-15436d1630c7",
  "requirementId": "036c98a1-410a-4636-b10d-cab5f56abbdc",
  "suiteName": "Employee — Save News Articles (Functional Happy Paths)",
  "case": {
    "id": "save-latest-article-and-view-in-saved",
    "title": "Save a Latest News article and verify it appears in My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step-open-home",
        "action": "openUrl",
        "targetDescription": "Open Commons QA home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "step-wait-home",
        "action": "waitForVisible",
        "targetDescription": "Wait for home content",
        "locatorHint": "[data-testid='home-content']"
      },
      {
        "id": "step-scroll-latest",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to Latest News section",
        "locatorHint": "[data-testid='latest-news']"
      },
      {
        "id": "step-assert-latest-card",
        "action": "assertVisible",
        "targetDescription": "Verify specific Latest article card is visible",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article Beta']"
      },
      {
        "id": "step-assert-bookmark-latest",
        "action": "assertVisible",
        "targetDescription": "Verify bookmark icon visible on Latest card",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article Beta'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "step-save-latest",
        "action": "tap",
        "targetDescription": "Tap bookmark icon to save Latest article",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article Beta'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "step-wait-toast",
        "action": "waitForVisible",
        "targetDescription": "Wait for success toast",
        "locatorHint": "[data-testid='toast']"
      },
      {
        "id": "step-assert-toast-text",
        "action": "assertContainsText",
        "targetDescription": "Verify success toast message",
        "locatorHint": "[data-testid='toast']",
        "assertion": "News saved successfully!, View saved news under Profile"
      },
      {
        "id": "step-assert-filled-latest",
        "action": "assertVisible",
        "targetDescription": "Verify filled bookmark icon indicates saved",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article Beta'] [data-testid='bookmark-filled']"
      },
      {
        "id": "step-open-profile-menu",
        "action": "tap",
        "targetDescription": "Open Profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "step-open-my-saved-news",
        "action": "tap",
        "targetDescription": "Navigate to My saved news from Profile",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "step-wait-saved-list",
        "action": "waitForVisible",
        "targetDescription": "Wait for My saved news list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "step-assert-saved-item-visible",
        "action": "assertVisible",
        "targetDescription": "Verify saved Latest item appears in list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Latest Article Beta']"
      },
      {
        "id": "step-cleanup-unsave-in-list",
        "action": "tap",
        "targetDescription": "Cleanup: Unsave the article from saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Latest Article Beta'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "step-wait-item-removed",
        "action": "waitForHidden",
        "targetDescription": "Wait for item to be removed from saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Latest Article Beta']"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
