  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-unsave-from-saved-list-removes-immediately",
    "title": "Unsaving from My Saved News removes the item immediately",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest News section",
        "locatorHint": "[data-testid='section-latest-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Latest card for fixture: Latest Article 2",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-2']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Save Latest Article 2",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-2'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled bookmark indicator appears on Latest Article 2",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-2'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Verify Latest Article 2 is listed",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-2']"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Unsave Latest Article 2 from Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-2'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s11",
        "action": "wait",
        "targetDescription": "Wait for list to update"
      },
      {
        "id": "s12",
        "action": "assertCount",
        "targetDescription": "Latest Article 2 removed from Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-2']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
