{
  "id": "save-multiple-articles-and-validate-count",
  "testPlanId": "415fac90-66de-4750-a83c-bccd233022f0",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles — E2E",
  "case": {
    "id": "save-multiple-articles-and-validate-count",
    "title": "Save multiple articles from different sections and validate all appear in My saved news, then unsave one",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "Featured article 'Automation Featured Article 3' is visible on Home and is not saved for the test user",
      "Latest article 'Automation Latest Article 3' is visible on Home and is not saved for the test user"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured section",
        "locatorHint": "[data-testid='featured-news-section']"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Bookmark 'Automation Featured Article 3'",
        "locatorHint": "[data-testid='featured-news-section'] [data-testid='news-card']:has-text('Automation Featured Article 3') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s4",
        "action": "waitForVisible",
        "targetDescription": "Latest section",
        "locatorHint": "[data-testid='latest-news-section']"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Bookmark 'Automation Latest Article 3'",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='news-card']:has-text('Automation Latest Article 3') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Go to 'My saved news'",
        "locatorHint": "[role='menuitem'][name='My saved news']"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "'Automation Featured Article 3' present in Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 3')"
      },
      {
        "id": "s10",
        "action": "assertVisible",
        "targetDescription": "'Automation Latest Article 3' present in Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Latest Article 3')"
      },
      {
        "id": "s11",
        "action": "assertCountGreaterThan",
        "targetDescription": "At least 2 saved items listed",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']"
      },
      {
        "id": "s12",
        "action": "tap",
        "targetDescription": "Unsave 'Automation Latest Article 3' from Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Latest Article 3') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s13",
        "action": "waitForHidden",
        "targetDescription": "'Automation Latest Article 3' removed from Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Latest Article 3')"
      },
      {
        "id": "s14",
        "action": "assertVisible",
        "targetDescription": "'Automation Featured Article 3' remains in Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 3')"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
