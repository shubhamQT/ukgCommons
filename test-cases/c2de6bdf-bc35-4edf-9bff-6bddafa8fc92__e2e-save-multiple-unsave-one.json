{
  "id": "e2e-save-multiple-unsave-one",
  "testPlanId": "c2de6bdf-bc35-4edf-9bff-6bddafa8fc92",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-save-multiple-unsave-one",
    "title": "Save multiple Latest articles and unsave one without affecting others",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest section visible",
        "locatorHint": "[data-testid='section-latest-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Latest Article 3 card",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-3']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Save Latest Article 3",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-3'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled icon on Latest Article 3",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-3'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "scrollIntoView",
        "targetDescription": "Latest Article 4 card",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-4']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Save Latest Article 4",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-4'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "Filled icon on Latest Article 4",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-4'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Go to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s11",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s12",
        "action": "assertVisible",
        "targetDescription": "Latest Article 3 present in Saved",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-3']"
      },
      {
        "id": "s13",
        "action": "assertVisible",
        "targetDescription": "Latest Article 4 present in Saved",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-4']"
      },
      {
        "id": "s14",
        "action": "tap",
        "targetDescription": "Unsave Latest Article 3 from Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-3'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s15",
        "action": "wait",
        "targetDescription": "Wait for removal"
      },
      {
        "id": "s16",
        "action": "assertCount",
        "targetDescription": "Latest Article 3 removed from Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-3']"
      },
      {
        "id": "s17",
        "action": "assertVisible",
        "targetDescription": "Latest Article 4 remains in Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-4']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
