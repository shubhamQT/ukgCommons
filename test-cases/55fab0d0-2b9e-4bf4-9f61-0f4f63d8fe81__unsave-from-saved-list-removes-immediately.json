{
  "id": "unsave-from-saved-list-removes-immediately",
  "testPlanId": "55fab0d0-2b9e-4bf4-9f61-0f4f63d8fe81",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "unsave-from-saved-list-removes-immediately",
    "title": "Unsave a saved article from My saved news and verify it disappears immediately",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "open-home",
        "action": "openUrl",
        "targetDescription": "Open Commons QA home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "wait-home",
        "action": "waitForVisible",
        "targetDescription": "Any news section visible",
        "locatorHint": "[data-testid='featured-news-section'], [data-testid='latest-news-section']",
        "value": "15000"
      },
      {
        "id": "scroll-article",
        "action": "scrollIntoView",
        "targetDescription": "Target article card by title",
        "locatorHint": "[data-testid='news-card']:has-text(\"Take the next step in your development at UKG\")"
      },
      {
        "id": "ensure-saved",
        "action": "tap",
        "targetDescription": "Tap bookmark to set Saved (assumes not already saved)",
        "locatorHint": "[data-testid='news-card']:has-text(\"Take the next step in your development at UKG\") [data-testid='bookmark-toggle']"
      },
      {
        "id": "assert-saved-on-card",
        "action": "assertContainsText",
        "targetDescription": "Confirm Saved state on card",
        "locatorHint": "[data-testid='news-card']:has-text(\"Take the next step in your development at UKG\") [data-testid='bookmark-toggle']",
        "assertion": "Saved"
      },
      {
        "id": "open-profile",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button'], [aria-label='Profile']"
      },
      {
        "id": "open-saved",
        "action": "tap",
        "targetDescription": "Go to My saved news",
        "locatorHint": "[role='menuitem'][name='My saved news'], a[href*='saved']"
      },
      {
        "id": "wait-saved",
        "action": "waitForVisible",
        "targetDescription": "Saved news section",
        "locatorHint": "[data-testid='saved-news-section']",
        "value": "10000"
      },
      {
        "id": "assert-item-listed",
        "action": "assertVisible",
        "targetDescription": "Saved item present before unsaving",
        "locatorHint": "[data-testid='saved-news-item']:has-text(\"Take the next step in your development at UKG\")"
      },
      {
        "id": "tap-unsave",
        "action": "tap",
        "targetDescription": "Unsave the item from saved list",
        "locatorHint": "[data-testid='saved-news-item']:has-text(\"Take the next step in your development at UKG\") [data-testid='bookmark-toggle']"
      },
      {
        "id": "assert-item-removed",
        "action": "assertHidden",
        "targetDescription": "Saved item disappears immediately",
        "locatorHint": "[data-testid='saved-news-item']:has-text(\"Take the next step in your development at UKG\")"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
