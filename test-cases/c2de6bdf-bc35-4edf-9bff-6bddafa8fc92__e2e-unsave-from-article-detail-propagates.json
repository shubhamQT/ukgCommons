{
  "id": "e2e-unsave-from-article-detail-propagates",
  "testPlanId": "c2de6bdf-bc35-4edf-9bff-6bddafa8fc92",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-unsave-from-article-detail-propagates",
    "title": "Unsave from Article Detail removes from Saved and updates list card state",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured section visible",
        "locatorHint": "[data-testid='section-featured-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Featured card for fixture: Feature Article 2",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Save Feature Article 2",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled icon on Feature Article 2",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open Feature Article 2 detail from card title",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2'] [data-testid='news-card-title-link']"
      },
      {
        "id": "s7",
        "action": "waitForVisible",
        "targetDescription": "Article detail title",
        "locatorHint": "[data-testid='article-title']"
      },
      {
        "id": "s8",
        "action": "assertVisible",
        "targetDescription": "Saved state visible on detail save toggle",
        "locatorHint": "[data-testid='save-toggle'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Unsave from detail page",
        "locatorHint": "[data-testid='save-toggle']"
      },
      {
        "id": "s10",
        "action": "waitForHidden",
        "targetDescription": "Filled icon hidden on detail after unsave",
        "locatorHint": "[data-testid='save-toggle'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s11",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s12",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s13",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s14",
        "action": "assertCount",
        "targetDescription": "Feature Article 2 not present in Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='feature-2']"
      },
      {
        "id": "s15",
        "action": "tap",
        "targetDescription": "Return to Home via site logo",
        "locatorHint": "[data-testid='site-logo']"
      },
      {
        "id": "s16",
        "action": "waitForVisible",
        "targetDescription": "Featured section visible",
        "locatorHint": "[data-testid='section-featured-news']"
      },
      {
        "id": "s17",
        "action": "scrollIntoView",
        "targetDescription": "Locate Feature Article 2 card again",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2']"
      },
      {
        "id": "s18",
        "action": "waitForHidden",
        "targetDescription": "Filled icon not visible on card (unsaved state)",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-2'] [data-testid='bookmark-fill']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
