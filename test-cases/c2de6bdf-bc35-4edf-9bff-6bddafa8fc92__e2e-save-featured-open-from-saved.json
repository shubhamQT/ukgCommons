{
  "id": "e2e-save-featured-open-from-saved",
  "testPlanId": "c2de6bdf-bc35-4edf-9bff-6bddafa8fc92",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-save-featured-open-from-saved",
    "title": "Save a Featured article, verify in My Saved News, and open full article",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured News section",
        "locatorHint": "[data-testid='section-featured-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Featured card for fixture: Feature Article 1",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-1']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Tap bookmark on Feature Article 1",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-1'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled bookmark indicator appears",
        "locatorHint": "[data-testid='section-featured-news'] [data-testid='news-card'][data-article-slug='feature-1'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Saved item present: Feature Article 1",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='feature-1']"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open saved item to full article",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='feature-1'] [data-testid='saved-news-title']"
      },
      {
        "id": "s11",
        "action": "waitForVisible",
        "targetDescription": "Article detail title visible",
        "locatorHint": "[data-testid='article-title']"
      },
      {
        "id": "s12",
        "action": "assertContainsText",
        "targetDescription": "Detail page shows expected article title",
        "locatorHint": "[data-testid='article-title']",
        "assertion": "Feature Article 1"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
