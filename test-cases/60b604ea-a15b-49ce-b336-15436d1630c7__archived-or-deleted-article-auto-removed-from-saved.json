{
  "id": "archived-or-deleted-article-auto-removed-from-saved",
  "testPlanId": "60b604ea-a15b-49ce-b336-15436d1630c7",
  "requirementId": "036c98a1-410a-4636-b10d-cab5f56abbdc",
  "suiteName": "Employee — Save News Articles (Functional Happy Paths)",
  "case": {
    "id": "archived-or-deleted-article-auto-removed-from-saved",
    "title": "Archived/deleted article disappears from My saved news automatically",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "open-home",
        "action": "openUrl",
        "targetDescription": "Open Commons QA home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "wait-home",
        "action": "waitForVisible",
        "targetDescription": "Wait for home content",
        "locatorHint": "[data-testid='home-content']"
      },
      {
        "id": "scroll-latest",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to Latest News",
        "locatorHint": "[data-testid='latest-news']"
      },
      {
        "id": "save-ephemeral",
        "action": "tap",
        "targetDescription": "Save 'QA Ephemeral Article Gamma'",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Ephemeral Article Gamma'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "open-profile",
        "action": "tap",
        "targetDescription": "Open Profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "go-saved-news",
        "action": "tap",
        "targetDescription": "Go to My saved news",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "wait-saved",
        "action": "waitForVisible",
        "targetDescription": "Wait for Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "assert-ephemeral-present",
        "action": "assertVisible",
        "targetDescription": "Verify ephemeral item is present in saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Ephemeral Article Gamma']"
      },
      {
        "id": "archive-article-backend",
        "action": "openUrl",
        "targetDescription": "QA admin archive endpoint for the test article",
        "value": "https://commons-qa.util.ukg.com/qa-tools/articles/archive?id=qa-ephemeral-article-gamma"
      },
      {
        "id": "wait-backend-process",
        "action": "wait",
        "targetDescription": "Allow backend to process archiving",
        "value": "1500"
      },
      {
        "id": "open-saved-news-direct",
        "action": "openUrl",
        "targetDescription": "Re-open My saved news to refresh list",
        "value": "https://commons-qa.util.ukg.com/profile/saved-news"
      },
      {
        "id": "wait-saved-refresh",
        "action": "waitForVisible",
        "targetDescription": "Wait for saved list after refresh",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "assert-ephemeral-removed",
        "action": "assertHidden",
        "targetDescription": "Verify archived item no longer appears in saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Ephemeral Article Gamma']"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
