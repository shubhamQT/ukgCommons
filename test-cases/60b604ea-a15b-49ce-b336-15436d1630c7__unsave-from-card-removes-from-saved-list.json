{
  "id": "unsave-from-card-removes-from-saved-list",
  "testPlanId": "60b604ea-a15b-49ce-b336-15436d1630c7",
  "requirementId": "036c98a1-410a-4636-b10d-cab5f56abbdc",
  "suiteName": "Employee — Save News Articles (Functional Happy Paths)",
  "case": {
    "id": "unsave-from-card-removes-from-saved-list",
    "title": "Unsave from article card removes it from My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "open-home",
        "action": "openUrl",
        "targetDescription": "Open Commons QA home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "wait-home",
        "action": "waitForVisible",
        "targetDescription": "Wait for home content",
        "locatorHint": "[data-testid='home-content']"
      },
      {
        "id": "scroll-latest",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to Latest News",
        "locatorHint": "[data-testid='latest-news']"
      },
      {
        "id": "save-to-remove",
        "action": "tap",
        "targetDescription": "Save 'QA Latest Article To Remove'",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article To Remove'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "open-profile",
        "action": "tap",
        "targetDescription": "Open Profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "go-saved-news",
        "action": "tap",
        "targetDescription": "Go to My saved news",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "wait-saved",
        "action": "waitForVisible",
        "targetDescription": "Wait for Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "assert-item-present",
        "action": "assertVisible",
        "targetDescription": "Verify the saved item is present",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Latest Article To Remove']"
      },
      {
        "id": "return-home",
        "action": "openUrl",
        "targetDescription": "Navigate back to home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "scroll-latest-again",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to Latest News",
        "locatorHint": "[data-testid='latest-news']"
      },
      {
        "id": "unsave-on-card",
        "action": "tap",
        "targetDescription": "Unsave the article directly on the card",
        "locatorHint": "[data-testid='latest-news'] [data-testid='news-card'][data-title='QA Latest Article To Remove'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "go-to-saved-news",
        "action": "openUrl",
        "targetDescription": "Open My saved news directly",
        "value": "https://commons-qa.util.ukg.com/profile/saved-news"
      },
      {
        "id": "wait-saved-list",
        "action": "waitForVisible",
        "targetDescription": "Wait for Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "assert-item-removed",
        "action": "assertHidden",
        "targetDescription": "Verify the item no longer appears in saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-title='QA Latest Article To Remove']"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
