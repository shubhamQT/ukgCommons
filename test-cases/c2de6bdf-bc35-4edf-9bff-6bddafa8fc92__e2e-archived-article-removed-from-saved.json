{
  "id": "e2e-archived-article-removed-from-saved",
  "testPlanId": "c2de6bdf-bc35-4edf-9bff-6bddafa8fc92",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-archived-article-removed-from-saved",
    "title": "Archived article disappears automatically from My Saved News",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest section visible",
        "locatorHint": "[data-testid='section-latest-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Latest card for archivable fixture",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='archivable-1']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Save archivable article",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='archivable-1'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled icon on archivable article",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='archivable-1'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "openUrl",
        "targetDescription": "Trigger QA hook to archive the article",
        "value": "https://commons-qa.util.ukg.com/qa/hooks/archive?slug=archivable-1"
      },
      {
        "id": "s7",
        "action": "waitForVisible",
        "targetDescription": "Hook response shown",
        "locatorHint": "body"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
        "targetDescription": "Hook response confirms archive",
        "locatorHint": "body",
        "assertion": "archived"
      },
      {
        "id": "s9",
        "action": "openUrl",
        "targetDescription": "Return to Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s11",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s12",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s13",
        "action": "assertCount",
        "targetDescription": "Archived article no longer appears in Saved list",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='archivable-1']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
