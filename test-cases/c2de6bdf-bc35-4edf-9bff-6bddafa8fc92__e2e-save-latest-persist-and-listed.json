{
  "id": "e2e-save-latest-persist-and-listed",
  "testPlanId": "c2de6bdf-bc35-4edf-9bff-6bddafa8fc92",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles - E2E",
  "case": {
    "id": "e2e-save-latest-persist-and-listed",
    "title": "Save a Latest article, verify persistence after navigation, and presence in My Saved News",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest News section",
        "locatorHint": "[data-testid='section-latest-news']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Latest card for fixture: Latest Article 1",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-1']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Tap bookmark on Latest Article 1",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-1'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Filled bookmark indicator appears on Latest Article 1",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-1'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s6",
        "action": "openUrl",
        "targetDescription": "Navigate again to Home to simulate reload",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s7",
        "action": "waitForVisible",
        "targetDescription": "Latest News section visible after navigation",
        "locatorHint": "[data-testid='section-latest-news']"
      },
      {
        "id": "s8",
        "action": "scrollIntoView",
        "targetDescription": "Latest card Latest Article 1",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-1']"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Saved state persists (filled icon) on Latest Article 1",
        "locatorHint": "[data-testid='section-latest-news'] [data-testid='news-card'][data-article-slug='latest-1'] [data-testid='bookmark-fill']"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-trigger']"
      },
      {
        "id": "s11",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-my-saved-news']"
      },
      {
        "id": "s12",
        "action": "waitForVisible",
        "targetDescription": "Saved News list visible",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s13",
        "action": "assertVisible",
        "targetDescription": "Saved item present: Latest Article 1",
        "locatorHint": "[data-testid='saved-news-item'][data-article-slug='latest-1']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
