{
  "id": "save-latest-persist-after-reload",
  "testPlanId": "415fac90-66de-4750-a83c-bccd233022f0",
  "requirementId": "1e00dbc0-4a03-49b1-8077-40b6f38dda88",
  "suiteName": "Save News Articles — E2E",
  "case": {
    "id": "save-latest-persist-after-reload",
    "title": "Save a Latest news article and verify persistence after page reload and presence in My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "Latest article 'Automation Latest Article 1' is visible on Home and is not saved for the test user"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest News section",
        "locatorHint": "[data-testid='latest-news-section']"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Bookmark icon on 'Automation Latest Article 1' card",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='news-card']:has-text('Automation Latest Article 1') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s4",
        "action": "assertContainsText",
        "targetDescription": "Saved indicator on the same Latest card",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='news-card']:has-text('Automation Latest Article 1')",
        "assertion": "Saved"
      },
      {
        "id": "s5",
        "action": "openUrl",
        "targetDescription": "Reload Commons Home to validate persistence",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s6",
        "action": "waitForVisible",
        "targetDescription": "Latest News section after reload",
        "locatorHint": "[data-testid='latest-news-section']"
      },
      {
        "id": "s7",
        "action": "assertContainsText",
        "targetDescription": "Saved indicator persists on 'Automation Latest Article 1' card",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='news-card']:has-text('Automation Latest Article 1')",
        "assertion": "Saved"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Select 'My saved news'",
        "locatorHint": "[role='menuitem'][name='My saved news']"
      },
      {
        "id": "s10",
        "action": "waitForVisible",
        "targetDescription": "Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "s11",
        "action": "assertVisible",
        "targetDescription": "'Automation Latest Article 1' appears in Saved list",
        "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Latest Article 1')"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
