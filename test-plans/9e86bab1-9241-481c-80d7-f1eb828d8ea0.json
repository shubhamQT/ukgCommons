  "plan": {
    "version": 1,
    "suiteName": "Employee Save News Articles - Functional Tests",
    "cases": [
      {
        "id": "save_article_from_featured_news",
        "title": "Save an article from Featured News and verify it appears in My Saved News",
        "priority": "P0",
        "platforms": [
          "chrome"
        ],
        "preconditions": [],
        "steps": [
          {
            "id": "step1",
            "action": "openUrl",
            "targetDescription": "Open the Commons QA homepage",
            "value": "https://commons-qa.util.ukg.com"
          },
          {
            "id": "step2",
            "action": "tap",
            "targetDescription": "Tap 'Continue with SSO' button if visible",
            "locatorHint": "button:has-text('Continue with SSO')",
            "assertion": "true"
          },
          {
            "id": "step3",
            "action": "scrollIntoView",
            "targetDescription": "Scroll to Featured News section",
            "locatorHint": "section#featured-news"
          },
          {
            "id": "step4",
            "action": "assertVisible",
            "targetDescription": "Verify bookmark icon is visible on a Featured News article card",
            "locatorHint": "section#featured-news article .bookmark-icon"
          },
          {
            "id": "step5",
            "action": "tap",
            "targetDescription": "Tap the bookmark icon on the first Featured News article",
            "locatorHint": "section#featured-news article:nth-of-type(1) .bookmark-icon"
          },
          {
            "id": "step6",
            "action": "assertVisible",
            "targetDescription": "Verify the bookmark icon changes to filled (saved) state",
            "locatorHint": "section#featured-news article:nth-of-type(1) .bookmark-icon.saved"
          },
          {
            "id": "step7",
            "action": "assertContainsText",
            "targetDescription": "Verify toast message 'News saved successfully!, View saved news under Profile' appears",
            "locatorHint": ".toast-message",
            "assertion": "News saved successfully!, View saved news under Profile"
          },
          {
            "id": "step8",
            "action": "tap",
            "targetDescription": "Tap on Profile icon",
            "locatorHint": "button[aria-label='Profile']"
          },
          {
            "id": "step9",
            "action": "tap",
            "targetDescription": "Tap on 'My saved news' link under Profile",
            "locatorHint": "a:has-text('My saved news')"
          },
          {
            "id": "step10",
            "action": "assertVisible",
            "targetDescription": "Verify redirection to My Saved News page",
            "locatorHint": "h1:has-text('My Saved News')"
          },
          {
            "id": "step11",
            "action": "assertContainsText",
            "targetDescription": "Verify the saved article appears in My Saved News list",
            "locatorHint": "section#saved-news-list article",
            "assertion": "true"
          }
        ],
        "tags": [
          "@functional",
          "@regression"
        ]
      },
