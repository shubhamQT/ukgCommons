      {
        "id": "save-featured-to-saved-open-detail-unsave-in-saved",
        "title": "Save a Featured news article, verify in My saved news, open detail, then unsave from Saved list",
        "priority": "P0",
        "platforms": [
          "chrome"
        ],
        "preconditions": [
          "Featured article 'Automation Featured Article 1' is visible on Home and is not saved for the test user"
        ],
        "steps": [
          {
            "id": "s1",
            "action": "openUrl",
            "targetDescription": "Open Commons Home",
            "value": "https://commons-qa.util.ukg.com/"
          },
          {
            "id": "s2",
            "action": "waitForVisible",
            "targetDescription": "Featured News section",
            "locatorHint": "[data-testid='featured-news-section']"
          },
          {
            "id": "s3",
            "action": "assertCountGreaterThan",
            "targetDescription": "Featured news cards present",
            "locatorHint": "[data-testid='featured-news-section'] [data-testid='news-card']"
          },
          {
            "id": "s4",
            "action": "tap",
            "targetDescription": "Bookmark icon on 'Automation Featured Article 1' card",
            "locatorHint": "[data-testid='featured-news-section'] [data-testid='news-card']:has-text('Automation Featured Article 1') [data-testid='bookmark-toggle']"
          },
          {
            "id": "s5",
            "action": "assertContainsText",
            "targetDescription": "Saved indicator on the same Featured card",
            "locatorHint": "[data-testid='featured-news-section'] [data-testid='news-card']:has-text('Automation Featured Article 1')",
            "assertion": "Saved"
          },
          {
            "id": "s6",
            "action": "tap",
            "targetDescription": "Open profile menu",
            "locatorHint": "[data-testid='profile-menu-button']"
          },
          {
            "id": "s7",
            "action": "tap",
            "targetDescription": "Select 'My saved news' from profile menu",
            "locatorHint": "[role='menuitem'][name='My saved news']"
          },
          {
            "id": "s8",
            "action": "waitForVisible",
            "targetDescription": "Saved News list",
            "locatorHint": "[data-testid='saved-news-list']"
          },
          {
            "id": "s9",
            "action": "assertVisible",
            "targetDescription": "Saved item 'Automation Featured Article 1' present in list",
            "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 1')"
          },
          {
            "id": "s10",
            "action": "tap",
            "targetDescription": "Open the saved item to article detail",
            "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 1') a"
          },
          {
            "id": "s11",
            "action": "waitForVisible",
            "targetDescription": "Article detail title",
            "locatorHint": "[data-testid='article-title']"
          },
          {
            "id": "s12",
            "action": "assertContainsText",
            "targetDescription": "Verify article detail shows correct title",
            "locatorHint": "[data-testid='article-title']",
            "assertion": "Automation Featured Article 1"
          },
          {
            "id": "s13",
            "action": "back",
            "targetDescription": "Return to Saved News list"
          },
          {
            "id": "s14",
            "action": "waitForVisible",
            "targetDescription": "Saved News list visible again",
            "locatorHint": "[data-testid='saved-news-list']"
          },
          {
            "id": "s15",
            "action": "tap",
            "targetDescription": "Unsave the item from Saved list",
            "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 1') [data-testid='bookmark-toggle']"
          },
          {
            "id": "s16",
            "action": "waitForHidden",
            "targetDescription": "Item removed from Saved list immediately",
            "locatorHint": "[data-testid='saved-news-list'] [data-testid='saved-news-item']:has-text('Automation Featured Article 1')"
          }
